-- Pure defensive transactions. Geometry, network delivery and physics remain Studio checks.
local Rules = require("../src/shared/DefenceRules")
local passed, failed = 0, 0
local function test(name, callback)
	local ok, message = pcall(callback)
	if ok then passed += 1; print("PASS " .. name)
	else failed += 1; warn("FAIL " .. name .. ": " .. tostring(message)) end
end
local function near(actual, expected)
	assert(math.abs(actual - expected) < 1e-6, "Expected " .. expected .. ", got " .. tostring(actual))
end
local function ctx(changes)
	local context = { alive = true, canAct = true, hasShield = true, pathClear = true, moving = true, facingDot = 1 }
	for key, value in changes or {} do context[key] = value end
	return context
end
local function combat(stamina)
	return { stamina = stamina or 100, mana = 57, nextBasic = 8, nextSkill = 9 }
end
local function accept(state, resources, action, argument, now, context)
	local ok, message = Rules.act(state, resources, action, argument, now, context or ctx())
	assert(ok, message)
end
local function rejected(state, resources, action, argument, now, context)
	local before, resourceBefore = table.clone(state), table.clone(resources)
	assert(not Rules.act(state, resources, action, argument, now, context or ctx()))
	for key, value in before do assert(state[key] == value, "Rejected action changed " .. key) end
	for key, value in resourceBefore do assert(resources[key] == value, "Rejected action changed resource " .. key) end
end
local function blocked(stamina)
	local state, resources = Rules.newState(0), combat(stamina)
	accept(state, resources, "Block", true, 0)
	return state, resources
end

test("module and balance values are frozen with bounded movement and costs", function()
	assert(table.isfrozen(Rules) and table.isfrozen(Rules.Config))
	local c = Rules.Config
	assert(c.dodgeDistance == 8 and c.dodgeInvulnerability == 0.25 and c.dodgeCooldown == 1.2)
	assert(c.sprintMultiplier > 1 and c.sprintMultiplier <= 1.5 and c.blockSpeed >= 4 and c.blockSpeed <= 8)
	assert(c.blockDamageMultiplier > 0 and c.blockDamageMultiplier < 1 and c.dodgeCost <= 100)
end)
test("fresh states are independent and preserve an authoritative clock", function()
	local first, second = Rules.newState(10), Rules.newState(10)
	accept(first, combat(), "Block", true, 10)
	assert(first.blocking and not second.blocking and second.lastTick == 10 and second.nextDodge == 0)
end)
test("invalid constructor times cannot create a state", function()
	for _, now in { -1, 0 / 0, math.huge, "now", {} } do assert(not pcall(Rules.newState, now)) end
end)
test("dodge spends exactly eighteen stamina and starts both server windows", function()
	local state, resources = Rules.newState(5), combat()
	accept(state, resources, "Dodge", nil, 5)
	assert(resources.stamina == 82 and resources.mana == 57 and resources.nextBasic == 8 and resources.nextSkill == 9)
	near(state.dodgeUntil, 5.25); near(state.nextDodge, 6.2)
end)
test("same-tick dodge spam never repeats movement approval or resource spending", function()
	local state, resources = Rules.newState(0), combat()
	accept(state, resources, "Dodge", nil, 0)
	for _ = 1, 100 do rejected(state, resources, "Dodge", nil, 0) end
	assert(resources.stamina == 82)
end)
test("dodge accepts the cooldown boundary and rejects immediately before it", function()
	local state, resources = Rules.newState(0), combat()
	accept(state, resources, "Dodge", nil, 0)
	rejected(state, resources, "Dodge", nil, 1.199)
	accept(state, resources, "Dodge", nil, 1.2)
	assert(resources.stamina == 64)
end)
test("blocked and unsupported dodge paths reject without changing the cooldown", function()
	for _, value in { false, 1, "yes" } do
		local state, resources = Rules.newState(0), combat()
		rejected(state, resources, "Dodge", nil, 0, ctx({ pathClear = value }))
	end
end)
test("dodge requires its exact stamina cost but may spend down to zero", function()
	rejected(Rules.newState(0), combat(17.99), "Dodge", nil, 0)
	local state, resources = Rules.newState(0), combat(18)
	accept(state, resources, "Dodge", nil, 0)
	assert(resources.stamina == 0)
end)
test("dodge atomically cancels either held stance", function()
	for _, stance in { "Block", "Sprint" } do
		local state, resources = Rules.newState(0), combat()
		accept(state, resources, stance, true, 0)
		accept(state, resources, "Dodge", nil, 0)
		assert(not state.blocking and not state.sprinting and resources.stamina == 82)
	end
end)
test("blocking requires a real shield and enough stamina to absorb a hit", function()
	rejected(Rules.newState(0), combat(), "Block", true, 0, ctx({ hasShield = false }))
	rejected(Rules.newState(0), combat(9.99), "Block", true, 0)
	local state, resources = Rules.newState(0), combat(10)
	accept(state, resources, "Block", true, 0)
	assert(state.blocking and resources.stamina == 10)
end)
test("sprint requires actual movement and at least one stamina", function()
	rejected(Rules.newState(0), combat(), "Sprint", true, 0, ctx({ moving = false }))
	rejected(Rules.newState(0), combat(0.99), "Sprint", true, 0)
	local state, resources = Rules.newState(0), combat(1)
	accept(state, resources, "Sprint", true, 0)
	assert(state.sprinting)
end)
test("switching stances never enables sprinting and blocking together", function()
	local state, resources = blocked()
	accept(state, resources, "Sprint", true, 0)
	assert(state.sprinting and not state.blocking)
	accept(state, resources, "Block", true, 0)
	assert(state.blocking and not state.sprinting)
end)
test("dead and paused characters cannot start any defensive action", function()
	for _, condition in { "alive", "canAct" } do
		for _, action in { "Dodge", "Block", "Sprint" } do
			rejected(Rules.newState(0), combat(), action, if action == "Dodge" then nil else true, 0, ctx({ [condition] = false }))
		end
	end
end)
test("releasing either stance remains allowed while dead or paused", function()
	for _, action in { "Block", "Sprint" } do
		local state, resources = Rules.newState(0), combat()
		accept(state, resources, action, true, 0)
		accept(state, resources, action, false, 0, ctx({ alive = false, canAct = false }))
		assert(not state.blocking and not state.sprinting and resources.stamina == 100)
	end
end)
test("malformed action names and stance flags reject atomically", function()
	for _, action in { "Damage", "dodge", false, {}, 1 } do rejected(Rules.newState(0), combat(), action, nil, 0) end
	for _, flag in { 1, "true", {}, "false" } do
		rejected(Rules.newState(0), combat(), "Block", flag, 0)
		rejected(Rules.newState(0), combat(), "Sprint", flag, 0)
		rejected(Rules.newState(0), combat(), "Dodge", flag, 0)
	end
end)
test("dodge invulnerability cannot be extended by another stance", function()
	local state, resources = Rules.newState(0), combat()
	accept(state, resources, "Dodge", nil, 0)
	rejected(state, resources, "Block", true, 0.1)
	rejected(state, resources, "Sprint", true, 0.1)
	near(state.dodgeUntil, 0.25)
end)
test("a held shield drains four stamina per second without touching mana", function()
	local state, resources = blocked()
	assert(Rules.tick(state, resources, 2.5, ctx()))
	assert(resources.stamina == 90 and resources.mana == 57 and state.blocking)
end)
test("moving sprint drains twenty-two stamina per second", function()
	local state, resources = Rules.newState(0), combat()
	accept(state, resources, "Sprint", true, 0)
	assert(Rules.tick(state, resources, 2, ctx()))
	assert(resources.stamina == 56 and state.sprinting)
end)
test("stopping movement charges its prior sprint interval then clears idle drain", function()
	local state, resources = Rules.newState(0), combat()
	accept(state, resources, "Sprint", true, 0)
	assert(Rules.tick(state, resources, 1, ctx({ moving = false })))
	assert(resources.stamina == 78 and not state.sprinting)
	assert(Rules.tick(state, resources, 2, ctx({ moving = false })) and resources.stamina == 78)
end)
test("losing a shield cancels guard and restores regeneration eligibility", function()
	local state, resources = blocked()
	assert(Rules.tick(state, resources, 1, ctx({ hasShield = false })))
	assert(not state.blocking and resources.stamina == 96 and Rules.staminaRegenScale(state) == 1)
end)
test("tick clears stances after death or ownership loss without negative resources", function()
	for _, condition in { "alive", "canAct" } do
		local state, resources = blocked()
		assert(Rules.tick(state, resources, 1, ctx({ [condition] = false })))
		assert(not state.blocking and not state.sprinting and resources.stamina == 100)
	end
end)
test("exhaustion clamps at zero and enforces a one-second guard recovery", function()
	local state, resources = blocked(10)
	assert(Rules.tick(state, resources, 4, ctx()))
	assert(resources.stamina == 0 and not state.blocking and not state.sprinting)
	near(state.nextBlock, 5)
	resources.stamina = 100
	rejected(state, resources, "Block", true, 4.99)
	accept(state, resources, "Block", true, 5)
end)
test("zero-time ticks cannot drain twice and idle ticks never regenerate", function()
	local state, resources = blocked()
	assert(Rules.tick(state, resources, 1, ctx()))
	assert(Rules.tick(state, resources, 1, ctx()) and resources.stamina == 96)
	accept(state, resources, "Block", false, 1)
	assert(Rules.tick(state, resources, 100, ctx()) and resources.stamina == 96)
end)
test("backwards and nonfinite clocks reject before mutating stance or stamina", function()
	for _, now in { -1, 0 / 0, math.huge, "later" } do
		local state, resources = blocked()
		rejected(state, resources, "Block", false, now)
		local before = resources.stamina
		assert(not Rules.tick(state, resources, now, ctx()) and resources.stamina == before and state.blocking)
	end
end)
test("malformed state or shared stamina fails closed", function()
	for _, stamina in { -1, 101, 0 / 0, math.huge, "100" } do
		local state, resources = Rules.newState(0), { stamina = stamina }
		assert(not Rules.act(state, resources, "Block", true, 0, ctx()))
		assert(not Rules.tick(state, resources, 1, ctx()))
	end
	local state = Rules.newState(0)
	state.blocking, state.sprinting = true, true
	assert(not Rules.act(state, combat(), "Dodge", nil, 0, ctx()))
end)
test("front shield block reduces damage seventy percent and spends ten stamina", function()
	local state, resources = blocked()
	local amount, outcome = Rules.resolveDamage(state, resources, 20, 0, ctx())
	assert(outcome == "Blocked" and resources.stamina == 90 and state.blocking)
	near(amount, 6)
end)
test("the exact cone boundary blocks while side and rear attacks hit normally", function()
	for _, dot in { -1, 0, 0.1499 } do
		local state, resources = blocked()
		local amount, outcome = Rules.resolveDamage(state, resources, 20, 0, ctx({ facingDot = dot }))
		assert(amount == 20 and outcome == "Hit" and resources.stamina == 100)
	end
	local state, resources = blocked()
	local amount, outcome = Rules.resolveDamage(state, resources, 20, 0, ctx({ facingDot = 0.15 }))
	assert(outcome == "Blocked"); near(amount, 6)
end)
test("an insufficient guard breaks and takes full damage once", function()
	local state, resources = blocked(10)
	assert(Rules.tick(state, resources, 0.25, ctx()) and resources.stamina == 9)
	local amount, outcome = Rules.resolveDamage(state, resources, 20, 0.25, ctx())
	assert(amount == 20 and outcome == "GuardBroken" and resources.stamina == 9 and not state.blocking)
	near(state.nextBlock, 1.25)
	amount, outcome = Rules.resolveDamage(state, resources, 20, 0.25, ctx())
	assert(amount == 20 and outcome == "Hit" and resources.stamina == 9)
end)
test("exact last-hit guard stamina still blocks before guard exhaustion", function()
	local state, resources = blocked(10)
	local amount, outcome = Rules.resolveDamage(state, resources, 20, 0, ctx())
	assert(outcome == "Blocked" and resources.stamina == 0 and not state.blocking)
	near(amount, 6); near(state.nextBlock, 1)
end)
test("dodges suppress damage only before the exact invulnerability deadline", function()
	local state, resources = Rules.newState(0), combat()
	accept(state, resources, "Dodge", nil, 0)
	local amount, outcome = Rules.resolveDamage(state, resources, 20, 0.249, ctx())
	assert(amount == 0 and outcome == "Dodged" and resources.stamina == 82)
	amount, outcome = Rules.resolveDamage(state, resources, 20, 0.25, ctx())
	assert(amount == 20 and outcome == "Hit" and resources.stamina == 82)
end)
test("no shield means no block even if old state still held guard", function()
	local state, resources = blocked()
	local amount, outcome = Rules.resolveDamage(state, resources, 20, 0, ctx({ hasShield = false }))
	assert(amount == 20 and outcome == "Hit" and not state.blocking and resources.stamina == 100)
end)
test("paused or dead players take no defensive-service damage and lose stances", function()
	for _, condition in { "alive", "canAct" } do
		local state, resources = blocked()
		local amount, outcome = Rules.resolveDamage(state, resources, 20, 0, ctx({ [condition] = false }))
		assert(amount == 0 and outcome == "Paused" and resources.stamina == 100 and not state.blocking)
	end
end)
test("trusted damage rejects nonfinite amounts and invalid facing dots", function()
	for _, amount in { -1, 0, 10001, math.huge, 0 / 0, "20" } do
		local state, resources = blocked()
		assert(not pcall(Rules.resolveDamage, state, resources, amount, 0, ctx()))
		assert(state.blocking and resources.stamina == 100)
	end
	for _, dot in { -1.01, 1.01, math.huge, 0 / 0, "front" } do
		local state, resources = blocked()
		assert(not pcall(Rules.resolveDamage, state, resources, 20, 0, ctx({ facingDot = dot })))
		assert(state.blocking and resources.stamina == 100)
	end
end)
test("stamina regeneration is suppressed only during held stances", function()
	local state, resources = Rules.newState(0), combat()
	assert(Rules.staminaRegenScale(state) == 1)
	accept(state, resources, "Sprint", true, 0)
	assert(Rules.staminaRegenScale(state) == 0)
	accept(state, resources, "Block", true, 0)
	assert(Rules.staminaRegenScale(state) == 0)
	accept(state, resources, "Dodge", nil, 0)
	assert(Rules.staminaRegenScale(state) == 1)
end)

test("sub-tick movement stops cannot erase already active sprint drain", function()
	local state, resources = Rules.newState(0), combat()
	accept(state, resources, "Sprint", true, 0)
	assert(Rules.tick(state, resources, 0.19, ctx({ moving = false })))
	near(resources.stamina, 100 - 0.19 * 22)
	assert(not state.sprinting)
end)

test("sub-tick shield removal cannot erase already active guard drain", function()
	local state, resources = blocked()
	assert(Rules.tick(state, resources, 0.19, ctx({ hasShield = false })))
	near(resources.stamina, 100 - 0.19 * 4)
	assert(not state.blocking)
end)

print("Defence rules: " .. passed .. " passed, " .. failed .. " failed")
assert(failed == 0, "Defence rules failed")
